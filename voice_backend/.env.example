# Copy to voice_backend/.env and fill. On Vercel, set these as Environment Variables instead.

# --- Required -------------------------------------------------------------

# Baseten (LLM, OpenAI-compatible)
BASETEN_API_KEY=replace_me

# Inworld (text-to-speech AND speech-to-text). Use the "Copy Base64" value from the portal.
INWORLD_API_KEY=base64_key

# --- Optional (defaults shown) --------------------------------------------

BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

INWORLD_MODEL_ID=inworld-tts-2-flash
INWORLD_VOICE_ID=Olivia
INWORLD_SAMPLE_RATE=48000
# Language for both STT and TTS ("es", "en", ...). Leave empty to auto-detect.
INWORLD_LANGUAGE=es

# Turn detection for Inworld STT (milliseconds of trailing silence)
INWORLD_STT_MIN_SILENCE_MS=200
INWORLD_STT_MAX_SILENCE_MS=800
INWORLD_STT_EOT_CONFIDENCE=0.5

# Override the agent persona (default lives in app/agent/llm_client.py)
# AGENT_SYSTEM_PROMPT=

# Speech-to-text provider: "inworld" (default) or "fennec".
# Fennec's key service was returning 503 in October 2026; only switch back if it is working again.
ASR_PROVIDER=inworld
# FENNEC_API_KEY=replace_me
FENNEC_SAMPLE_RATE=16000
FENNEC_CHANNELS=1
